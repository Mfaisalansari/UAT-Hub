+<!DOCTYPE html>
+<html xmlns:th="http://www.thymeleaf.org" lang="en">
+<head th:replace="~{fragments :: head('Test run')}"></head>
+<body>
+<div class="shell">
+    <nav th:replace="~{fragments :: sidebar('runs')}"></nav>
+    <main class="main">
+        <header class="page-head">
+            <div>
+                <form method="get" th:action="@{/runs}" class="crumb" th:if="${allRuns.size() > 1}">
+                    <label class="sr" for="run-pick">Test run</label>
+                    <select id="run-pick" name="id" data-autosubmit class="mini-select">
+                        <option th:each="r : ${allRuns}" th:value="${r.id}" th:selected="${run != null and r.id == run.id}"
+                                th:text="${r.label} + (${r.active} ? ' (current)' : '')"></option>
+                    </select>
+                </form>
+                <p class="crumb" th:if="${run != null and allRuns.size() <= 1}" th:text="'Started ' + ${@fmt.when(run.createdAt)}"></p>
+                <h1 class="title" th:if="${run != null}"><span th:text="${run.name}"></span>
+                    <span class="muted-title" th:if="${run.build != null}" th:text="'· ' + ${run.build}"></span></h1>
+                <h1 class="title" th:if="${run == null}">Test run</h1>
+            </div>
+            <div class="actions" th:if="${run != null and me.canManageTests()}">
+                <a class="btn ghost" th:href="@{/runs/{id}/assign(id=${run.id})}">Assign scenarios</a>
+                <a class="btn ghost" th:href="@{/runs/{id}/export(id=${run.id})}">Export report</a>
+            </div>
+        </header>
+
+        <div th:replace="~{fragments :: flash}"></div>
+
+        <div class="empty" th:if="${run == null}">
+            <h2>No test run yet</h2>
+            <p th:unless="${me.canManageTests()}">QA starts a run when a build is ready for UAT.</p>
+            <form th:if="${me.canManageTests()}" method="post" th:action="@{/runs}" class="inline-form">
+                <div class="field"><label for="n1">Run name</label><input id="n1" name="name" required th:value="${project.currentCycle}" placeholder="UAT cycle 1"></div>
+                <div class="field"><label for="b1">Build / version</label><input id="b1" name="build" placeholder="e.g. 4.2.1"></div>
+                <button class="btn primary" type="submit">Start run</button>
+            </form>
+        </div>
+
+        <th:block th:if="${run != null}">
+            <section class="overall">
+                <div class="seg-bar" th:if="${totals.total() > 0}">
+                    <i class="s-pass" th:style="'flex-grow:' + ${totals.passed()}"></i>
+                    <i class="s-fail" th:style="'flex-grow:' + ${totals.failed()}"></i>
+                    <i class="s-blocked" th:style="'flex-grow:' + ${totals.blocked()}"></i>
+                    <i class="s-retest" th:style="'flex-grow:' + ${totals.retest()}"></i>
+                    <i class="s-none" th:style="'flex-grow:' + ${totals.notRun()}"></i>
+                </div>
+                <p class="legend">
+                    <span><i class="s-pass"></i>Passed <b th:text="${totals.passed()}"></b></span>
+                    <span><i class="s-fail"></i>Failed <b th:text="${totals.failed()}"></b></span>
+                    <span><i class="s-blocked"></i>Blocked <b th:text="${totals.blocked()}"></b></span>
+                    <span><i class="s-retest"></i>Re-test <b th:text="${totals.retest()}"></b></span>
+                    <span><i class="s-none"></i>Not run <b th:text="${totals.notRun()}"></b></span>
+                    <span class="push-right mono" th:text="${totals.percentDone()} + '% done of ' + ${totals.total()}"></span>
+                </p>
+            </section>
+
+            <div class="empty" th:if="${totals.total() == 0}">
+                <h2>No scenarios in this run yet</h2>
+                <p th:if="${me.canManageTests()}"><a th:href="@{/runs/{id}/assign(id=${run.id})}">Assign scenarios</a> to testers and business users.</p>
+            </div>
+
+            <div class="split runs-split" th:if="${totals.total() > 0}">
+                <section class="stack">
+                    <div class="table-wrap">
+                        <table class="table">
+                            <thead><tr><th>Line of business</th><th>Progress</th><th>Pass</th><th>Fail</th><th>Blocked</th><th>Open</th><th>Issues</th><th>Business sign-off</th></tr></thead>
+                            <tbody>
+                            <tr th:each="l : ${lobRows}" th:with="t=${l.totals()}">
+                                <td><b th:text="${l.lob()}"></b></td>
+                                <td class="w-bar"><span class="seg-bar thin">
+                                    <i class="s-pass" th:style="'flex-grow:' + ${t.passed()}"></i>
+                                    <i class="s-fail" th:style="'flex-grow:' + ${t.failed()}"></i>
+                                    <i class="s-blocked" th:style="'flex-grow:' + ${t.blocked()}"></i>
+                                    <i class="s-retest" th:style="'flex-grow:' + ${t.retest()}"></i>
+                                    <i class="s-none" th:style="'flex-grow:' + ${t.notRun()}"></i></span></td>
+                                <td class="mono c-pass" th:text="${t.passed()}"></td>
+                                <td class="mono c-fail" th:text="${t.failed()}"></td>
+                                <td class="mono c-blocked" th:text="${t.blocked()}"></td>
+                                <td class="mono muted" th:text="${t.notRun() + t.retest()}"></td>
+                                <td class="mono" th:classappend="${l.openIssues() > 0} ? 'c-fail' : 'muted'" th:text="${l.openIssues()}"></td>
+                                <td>
+                                    <span th:if="${l.signOff() != null}" class="signed" th:title="${l.signOff().note}"
+                                          th:text="'Signed off · ' + ${l.signOff().signedBy != null ? l.signOff().signedBy.name : ''}"></span>
+                                    <details th:if="${l.signOff() == null and me.canSignOff() and run.active}" class="signoff">
+                                        <summary class="linkish">Sign off</summary>
+                                        <form method="post" th:action="@{/runs/{id}/signoff(id=${run.id})}" class="stack-sm">
+                                            <input type="hidden" name="lob" th:value="${l.lob()}">
+                                            <label class="sr" th:for="'note-' + ${lStat.index}">Note</label>
+                                            <textarea th:id="'note-' + ${lStat.index}" name="note" rows="2"
+                                                      th:placeholder="${l.openIssues() > 0 or t.notRun() + t.retest() > 0} ? 'Required: why sign off with open items' : 'Optional note'"></textarea>
+                                            <button class="btn primary small-btn" type="submit">Confirm sign-off</button>
+                                        </form>
+                                    </details>
+                                    <span th:if="${l.signOff() == null and !(me.canSignOff() and run.active)}" class="muted">—</span>
+                                </td>
+                            </tr>
+                            </tbody>
+                        </table>
+                    </div>
+
+                    <div class="table-wrap" th:unless="${testers.isEmpty()}">
+                        <table class="table">
+                            <thead><tr><th>Person</th><th>Done</th><th>Progress</th></tr></thead>
+                            <tbody>
+                            <tr th:each="p : ${testers}">
+                                <td><div class="person"><span class="avatar" th:classappend="'r-' + ${p.person().role.name().toLowerCase()}" th:text="${p.person().initials}"></span>
+                                    <span><b th:text="${p.person().name}"></b><small th:text="${p.person().role.label}"></small></span></div></td>
+                                <td class="mono" th:text="${p.done()} + ' / ' + ${p.total()}"></td>
+                                <td class="w-bar"><span class="bar"><i th:style="'width:' + ${p.total() == 0 ? 0 : p.done() * 100 / p.total()} + '%'"></i></span></td>
+                            </tr>
+                            </tbody>
+                        </table>
+                    </div>
+                </section>
+
+                <aside class="side-stack">
+                    <h2 class="h2">Issues from testing</h2>
+                    <p class="small muted-2" th:if="${issues.isEmpty()}">None raised yet. Issues raised from failed steps appear here.</p>
+                    <a th:each="i : ${issues}" class="issue-card" th:href="@{/feedback/{id}(id=${i.feedback().id})}"
+                       th:classappend="${i.feedback().stage.name() == 'CLOSED'} ? 'done'">
+                        <span class="mono small"><span class="lime" th:text="${i.feedback().code}"></span>
+                            <span th:if="${i.feedback().fixedInBuild != null and i.feedback().stage.name() != 'CLOSED'}" class="cyan" th:text="'Fixed in ' + ${i.feedback().fixedInBuild} + ' · re-test'"></span>
+                            <span th:unless="${i.feedback().fixedInBuild != null and i.feedback().stage.name() != 'CLOSED'}" class="muted" th:text="${i.feedback().stage.label}"></span></span>
+                        <span th:text="${i.feedback().title}"></span>
+                        <small class="muted" th:text="${i.impact()}"></small>
+                    </a>
+
+                    <form th:if="${me.canManageTests() and run.active}" method="post" th:action="@{/runs/{id}/build(id=${run.id})}" class="card stack-sm">
+                        <h3 class="h3">Deploy new build</h3>
+                        <div class="field"><label for="nb">Build / version now in UAT</label>
+                            <input id="nb" name="build" required placeholder="e.g. 4.2.3"></div>
+                        <fieldset class="field" th:unless="${fixCandidates.isEmpty()}">
+                            <legend>Issues this build fixes</legend>
+                            <div class="checks column">
+                                <label th:each="f : ${fixCandidates}"><input type="checkbox" name="fixed" th:value="${f.id}">
+                                    <span><span class="mono lime" th:text="${f.code}"></span> <span th:text="${f.title}"></span></span></label>
+                            </div>
+                        </fieldset>
+                        <p class="small muted-2">Scenarios linked to the ticked issues go back to their testers as re-tests.</p>
+                        <button class="btn primary" type="submit">Record build</button>
+                    </form>
+
+                    <details class="card" th:if="${me.canManageTests()}">
+                        <summary class="h3">Start a new run</summary>
+                        <form method="post" th:action="@{/runs}" class="stack-sm">
+                            <div class="field"><label for="n2">Run name</label><input id="n2" name="name" required placeholder="UAT cycle 4"></div>
+                            <div class="field"><label for="b2">Build / version</label><input id="b2" name="build"></div>
+                            <p class="small muted-2">The current run is closed and kept for reference.</p>
+                            <button class="btn ghost" type="submit">Start run</button>
+                        </form>
+                    </details>
+                </aside>
+            </div>
+        </th:block>
+    </main>
+</div>
+<script th:src="@{/js/app.js}"></script>
+</body>
+</html>
diff --git a/src/main/resources/templates/scenario-edit.html b/src/main/resources/templates/scenario-edit.html
new file mode 100644
index 0000000..a371e44
--- /dev/null
+++ b/src/main/resources/templates/scenario-edit.html
@@ -0,0 +1,75 @@
+<!DOCTYPE html>
+<html xmlns:th="http://www.thymeleaf.org" lang="en">
+<head th:replace="~{fragments :: head(${s == null} ? 'New scenario' : ${s.code})}"></head>
+<body>
+<div class="shell">
+    <nav th:replace="~{fragments :: sidebar('scenarios')}"></nav>
+    <main class="main">
+        <header class="page-head">
+            <div>
+                <p class="crumb"><a th:href="@{/scenarios}">← Scenario library</a></p>
+                <h1 class="title" th:text="${s == null} ? 'New scenario' : 'Edit ' + ${s.code}"></h1>
+            </div>
+        </header>
+
+        <div th:replace="~{fragments :: flash}"></div>
+
+        <form method="post" class="card form-card" th:action="${s == null} ? @{/scenarios} : @{/scenarios/{id}(id=${s.id})}">
+            <div class="grid-code">
+                <div class="field"><label for="code">Scenario ID</label>
+                    <input id="code" name="code" class="mono" th:value="${s?.code}" placeholder="Auto, e.g. SC-015"></div>
+                <div class="field"><label for="title">Title <span class="req">*</span></label>
+                    <input id="title" name="title" required maxlength="300" th:value="${s?.title}" class="big"
+                           placeholder="What the user is trying to do"></div>
+            </div>
+            <div class="grid3">
+                <div class="field"><label for="lob">Line of business</label>
+                    <select id="lob" name="lob"><option value="">—</option>
+                        <option th:each="l : ${lobs}" th:value="${l}" th:text="${l}" th:selected="${s != null and l == s.lob}"></option></select></div>
+                <div class="field"><label for="division">Division</label>
+                    <select id="division" name="division"><option value="">—</option>
+                        <option th:each="d : ${divisions}" th:value="${d}" th:text="${d}" th:selected="${s != null and d == s.division}"></option></select></div>
+                <div class="field"><label for="priority">Priority</label>
+                    <select id="priority" name="priority">
+                        <option th:each="p : ${priorities}" th:value="${p.name()}" th:text="${p.label}"
+                                th:selected="${s != null ? p == s.priority : p.name() == 'MEDIUM'}"></option></select></div>
+            </div>
+            <div class="field"><label for="module">Pega case type › stage</label>
+                <input id="module" name="module" th:value="${s?.module}" placeholder="e.g. Quote › Endorsement"></div>
+            <div class="grid2">
+                <div class="field"><label for="pre">Preconditions</label>
+                    <textarea id="pre" name="preconditions" rows="3" th:text="${s?.preconditions}"></textarea></div>
+                <div class="field"><label for="td">Test data</label>
+                    <textarea id="td" name="testData" rows="3" th:text="${s?.testData}"></textarea></div>
+            </div>
+
+            <fieldset class="field">
+                <legend>Steps <span class="req">*</span></legend>
+                <ol class="step-editor" data-steps>
+                    <li th:if="${s != null}" th:each="st : ${s.steps}">
+                        <span class="mono muted n"></span>
+                        <textarea name="action" rows="2" aria-label="Action" placeholder="Action" th:text="${st.action}"></textarea>
+                        <textarea name="expected" rows="2" aria-label="Expected result" placeholder="Expected result" th:text="${st.expected}"></textarea>
+                        <button type="button" class="linkish danger" data-remove-step>Remove</button>
+                    </li>
+                    <li th:if="${s == null}" th:each="i : ${#numbers.sequence(1, 3)}">
+                        <span class="mono muted n"></span>
+                        <textarea name="action" rows="2" aria-label="Action" placeholder="Action"></textarea>
+                        <textarea name="expected" rows="2" aria-label="Expected result" placeholder="Expected result"></textarea>
+                        <button type="button" class="linkish danger" data-remove-step>Remove</button>
+                    </li>
+                </ol>
+                <button type="button" class="btn ghost small-btn" data-add-step>+ Add step</button>
+            </fieldset>
+
+            <footer class="form-foot">
+                <span class="muted small">Empty step rows are ignored. Steps that already have test results can be reworded but not removed.</span>
+                <a class="btn ghost" th:href="@{/scenarios}">Cancel</a>
+                <button class="btn primary" type="submit">Save scenario</button>
+            </footer>
+        </form>
+    </main>
+</div>
+<script th:src="@{/js/app.js}"></script>
+</body>
+</html>
diff --git a/src/main/resources/templates/scenarios.html b/src/main/resources/templates/scenarios.html
new file mode 100644
index 0000000..911c41a
--- /dev/null
+++ b/src/main/resources/templates/scenarios.html
@@ -0,0 +1,94 @@
+<!DOCTYPE html>
+<html xmlns:th="http://www.thymeleaf.org" lang="en">
+<head th:replace="~{fragments :: head('Scenario library')}"></head>
+<body>
+<div class="shell">
+    <nav th:replace="~{fragments :: sidebar('scenarios')}"></nav>
+    <main class="main">
+        <header class="page-head">
+            <div>
+                <p class="crumb">Reusable across UAT cycles</p>
+                <h1 class="title">Scenario library</h1>
+            </div>
+            <div class="actions">
+                <form method="post" enctype="multipart/form-data" class="inline"
+                      th:action="@{/scenarios/import(_csrf=${_csrf.token})}">
+                    <label class="btn ghost file-btn">Import Excel
+                        <input type="file" name="file" accept=".xlsx,.xls" data-autosubmit hidden>
+                    </label>
+                </form>
+                <a class="btn primary" th:href="@{/scenarios/new}">+ New scenario</a>
+            </div>
+        </header>
+
+        <div th:replace="~{fragments :: flash}"></div>
+
+        <form class="filters" method="get" th:action="@{/scenarios}">
+            <label class="sr" for="sq">Search scenarios</label>
+            <input id="sq" type="search" name="q" th:value="${q}" placeholder="Search ID, title, module">
+            <label class="sr" for="sl">Line of business</label>
+            <select id="sl" name="lob" data-autosubmit>
+                <option value="">All LOBs</option>
+                <option th:each="l : ${lobs}" th:value="${l}" th:text="${l}" th:selected="${l == fLob}"></option>
+            </select>
+            <input type="hidden" name="archived" th:value="${archived}">
+            <button class="btn ghost" type="submit">Search</button>
+            <a class="linkish" th:href="@{/scenarios(archived=${!archived})}"
+               th:text="${archived} ? 'Show active (' + ${activeCount} + ')' : 'Show archived (' + ${archivedCount} + ')'"></a>
+        </form>
+
+        <div class="split lib-split">
+            <section>
+                <div class="table-wrap" th:unless="${rows.isEmpty()}">
+                    <table class="table">
+                        <thead><tr><th>ID</th><th>Scenario</th><th>LOB / division</th><th>Steps</th><th>Priority</th></tr></thead>
+                        <tbody>
+                        <tr th:each="s : ${rows}" th:classappend="${sel != null and s.id == sel.id} ? 'row-on'">
+                            <td class="mono id"><a th:href="@{/scenarios(id=${s.id}, q=${q}, lob=${fLob}, archived=${archived})}" th:text="${s.code}"></a></td>
+                            <td class="title-cell"><a th:href="@{/scenarios(id=${s.id}, q=${q}, lob=${fLob}, archived=${archived})}" th:text="${s.title}"></a>
+                                <small th:text="${s.module}"></small></td>
+                            <td class="muted-2" th:text="${s.lobDivision}"></td>
+                            <td class="mono" th:text="${s.steps.size()}"></td>
+                            <td><span class="pri" th:classappend="'p-' + ${s.priority.css}" th:text="${s.priority.label}"></span></td>
+                        </tr>
+                        </tbody>
+                    </table>
+                </div>
+                <div class="empty" th:if="${rows.isEmpty()}">
+                    <h2 th:text="${archived} ? 'No archived scenarios' : 'No scenarios yet'"></h2>
+                    <p th:unless="${archived}">Import your scenario sheet with <b>Import Excel</b>: one row per step with columns
+                        Scenario ID, Title, LOB, Division, Module, Priority, Preconditions, Test data, Step, Action, Expected.
+                        Rows with the same Scenario ID become one scenario.</p>
+                </div>
+            </section>
+
+            <aside class="side-stack" th:if="${sel != null}">
+                <p class="mono small"><span class="lime" th:text="${sel.code}"></span>
+                    <span class="muted" th:text="' · ' + ${sel.lobDivision}"></span></p>
+                <h2 class="h2" th:text="${sel.title}"></h2>
+                <div class="pre-box" th:if="${sel.preconditions != null or sel.testData != null}">
+                    <span class="label">Preconditions &amp; test data</span>
+                    <p class="pre" th:if="${sel.preconditions != null}" th:text="${sel.preconditions}"></p>
+                    <p class="pre mono small" th:if="${sel.testData != null}" th:text="${sel.testData}"></p>
+                </div>
+                <ol class="lib-steps">
+                    <li th:each="st : ${sel.steps}">
+                        <span class="mono muted" th:text="${st.stepNo}"></span>
+                        <span><span th:text="${st.action}"></span>
+                            <small th:if="${st.expected != null}"><span class="muted">Expect · </span><span th:text="${st.expected}"></span></small></span>
+                    </li>
+                </ol>
+                <div class="row-actions">
+                    <a class="btn ghost small-btn" th:href="@{/scenarios/{id}/edit(id=${sel.id})}">Edit</a>
+                    <form method="post" th:action="@{/scenarios/{id}/archive(id=${sel.id})}" class="inline">
+                        <input type="hidden" name="active" th:value="${!sel.active}">
+                        <button class="linkish" th:classappend="${sel.active} ? 'danger'" type="submit" th:text="${sel.active} ? 'Archive' : 'Restore'"></button>
+                    </form>
+                </div>
+            </aside>
+        </div>
+    </main>
+</div>
+<script th:src="@{/js/app.js}"></script>
+</body>
+</html>
